# ActionReady web — SERVER-SIDE ONLY. Never prefix these with NEXT_PUBLIC_.
# Copy to .env.local (git-ignored) and fill in.

# "live" calls your n8n webhooks. "demo" runs labeled synthetic scenarios only, with no n8n call.
ACTIONREADY_MODE=demo

# Single-owner login for the private demonstration (min 12 chars).
APP_PASSWORD=change-me-to-a-long-passphrase
# 32+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Trusted project scope shown in the UI. The authoritative scope lives in the n8n Week 3 config node.
ACTIONREADY_PROJECT_ID=DEMO_ATLAS
ACTIONREADY_PROJECT_LABEL=Demo Atlas (synthetic)

# --- live mode only ---
# Production base, e.g. https://YOUR-INSTANCE.app.n8n.cloud/webhook  (not /webhook-test)
N8N_WEBHOOK_BASE=
# Header Auth credential configured on both n8n webhooks
N8N_WEBHOOK_HEADER_NAME=X-ActionReady-Key
N8N_WEBHOOK_SECRET=
# Status webhook path (relative to N8N_WEBHOOK_BASE, WITHOUT the job ID). n8n prefixes webhooks that have a
# path parameter with an instance-specific webhook ID, so copy it from the 'Website Job Status' node's Production URL:
#   https://<instance>/webhook/<webhook-id>/actionready/v1/jobs/:job_id  ->  <webhook-id>/actionready/v1/jobs
N8N_JOB_STATUS_PATH=
